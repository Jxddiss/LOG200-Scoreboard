---
import ApiHeader from '@/app/api';
import Layout from '@/layouts/layout.astro';
---

<Layout title="API du ladder Isolation">
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.34.1/swagger-ui.css"
      integrity="sha384-4c3vsE5f+trhFyHrFrLM1fFGUn531NIaC7dcqEWIJdoRQJ5CkJbSuSCwXLpaS1KF"
      crossorigin="anonymous"
    />
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.34.1/swagger-ui-bundle.js"
      integrity="sha384-XFYN47VzPiDY6qPtxYKg0nqUeW/upo20xf1j2SUE7gT/i35FJB4cuS/71Iegzk8Z"
      crossorigin="anonymous"></script>
  </Fragment>

  <ApiHeader client:only="react" />

  <main class="layout api-layout">
    <section id="swagger" class="panel swagger" aria-label="Documentation de l'API"></section>
  </main>

  <script is:inline type="module">
    const SERVER = document.querySelector('meta[name="scoreboard-server"]')?.content || '..';

    // Swagger UI a un thème sombre, activé par une classe sur <html> : suivre le système comme le site.
    const dark = matchMedia('(prefers-color-scheme: dark)');
    const theme = () => document.documentElement.classList.toggle('dark-mode', dark.matches);
    theme();
    dark.addEventListener('change', theme);

    // POST n'est pas autorisé par le préflight CORS de Caddy : PUT suffit pour soumettre.
    SwaggerUIBundle({ url: `${SERVER}/api/openapi.json`, dom_id: '#swagger', supportedSubmitMethods: ['get', 'put'] });
  </script>
</Layout>
